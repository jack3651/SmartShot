#include <winver.h>
#include "resource.h"

IDI_APP     ICON "smartshot.ico"
IDR_SHUTTER WAVE "shutter.wav"

// 兩個版本的 exe 都叫 SmartShot.exe（可以直接互相取代，開機自啟與設定共用）。
// itch.io 版（SMARTSHOT_PRO，含 DXGI）與 GitHub 開源版只差在 Comments 欄位。
#ifdef SMARTSHOT_PRO
#define SMARTSHOT_EDITION "itch.io edition"
#else
#define SMARTSHOT_EDITION "Open-source edition (GPL-3.0)"
#endif

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    SMARTSHOT_VERSION_NUM
 PRODUCTVERSION SMARTSHOT_VERSION_NUM
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040404B0"
        BEGIN
            VALUE "CompanyName",      "JackDev"
            VALUE "FileDescription",  "SmartShot"
            VALUE "FileVersion",      SMARTSHOT_VERSION_STR
            VALUE "ProductName",      "SmartShot"
            VALUE "ProductVersion",   SMARTSHOT_VERSION_STR
            VALUE "OriginalFilename", "SmartShot.exe"
            VALUE "LegalCopyright",   "Copyright (C) 2026 JackDev"
            VALUE "Comments",         SMARTSHOT_EDITION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0404, 1200
    END
END
